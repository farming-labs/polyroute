{
  "name": "polyroute-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @farming-labs/polyroute build",
    "test": "pnpm --filter @farming-labs/polyroute test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "fmt": "oxfmt",
