    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.9.0"
}
